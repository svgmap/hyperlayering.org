---
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import TableOfContents from "@components/TableOfContents.svelte";
import { defaultLang, languages } from "@i18n/ui";
import { getLangFromUrl } from "@i18n/utils";

interface Props {
	title: string;
	tocHeaders?: TocItem[] | undefined;
}

const lang = getLangFromUrl(Astro.url);
const { title, tocHeaders = [] } = Astro.props;
---

<main>
  <article class="content-layout stack">
    <section class="stack layout--wide header-section">
      <small class="route row"><slot name="route" /></small>
      <h1 class="title">{title}</h1>
      <div class="details row">
        <slot name="details" />
      </div>
    </section>
    <section id="content-body-wrapper">
      <div class="content-body layout flow">
        <slot name="content" />
      </div>
      <TableOfContents headers={tocHeaders} client:only="svelte"/>
    </section>
  </article>
</main>

<style scoped>
  :root {
    scroll-behavior: smooth;
  }
  #content-body-wrapper {
    anchor-name: --content-body;
    container-type: inline-size;
    container-name: content-body;
    display: grid;
    grid-template-columns: 1fr minmax(min(calc((var(--paragraph-width) / 1.5) * 2), 100%), 1fr) 1fr;
    gap: var(--space-sm);
    margin: 0 var(--space-md);
    @container (width <= calc(var(--paragraph-width) * 2)) {
      display: flex;
      flex-direction: column-reverse;
      margin: 0;
    }
  }

  .content-body {
    max-width: 100%;
    grid-column: 2;
  }

  .content-layout {
    container-type: inline-size;
  }

  .header-section {
    background-color: var(--bg-secondary);
    padding: var(--space-md);
    border-radius: var(--round-lg);

    .details {
      color: var(--text-secondary);
      justify-content: center;
    }
    .route {
      margin: 0 auto;
      color: var(--text-tertiary);
    }
  }
</style>
