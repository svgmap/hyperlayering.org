---
import "@styles/content.css";
import TableOfContents from "@components/TableOfContents.svelte";

interface Props {
	title: string;
	tocHeaders?: Map<string, TocItem> | undefined;
}

const { title, tocHeaders = undefined } = Astro.props;
---

<main>
  <article class="content-layout stack stack--zero">
    <section class="header-section">
      <div class="layout--wide stack" data-state="stack--xs">
        <small class="route row"><slot name="route" /></small>
        <h1 class="title">{title}</h1>
        <div class="details row">
          <slot name="details" />
        </div>
      </div>
    </section>
    <section
      id="content-body-wrapper"
      class:list={[{ "toc-content-layout": tocHeaders !== undefined }]}
    >
      <div class="content-body layout flow">
        <slot name="content" />
      </div>
      <TableOfContents headers={tocHeaders ?? new Map()} client:only="svelte" />
    </section>
  </article>
</main>
