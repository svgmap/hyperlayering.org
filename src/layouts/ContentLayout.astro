---
import TableOfContents from "@components/TableOfContents.svelte";

interface Props {
	title: string;
	tocHeaders?: Map<string, TocItem> | undefined;
}

const { title, tocHeaders = new Map() } = Astro.props;
---

<main>
  <article class="content-layout stack stack--zero">
    <section class="header-section">
      <div class="layout--wide stack">
        <small class="route row"><slot name="route" /></small>
        <h1 class="title">{title}</h1>
        <div class="details row">
          <slot name="details" />
        </div>
      </div>
    </section>
    <section id="content-body-wrapper">
      <div class="content-body layout flow">
        <slot name="content" />
      </div>
      <TableOfContents headers={tocHeaders} client:only="svelte" />
    </section>
  </article>
</main>

<style scoped>
  #content-body-wrapper {
    anchor-name: --content-body;
    container-type: inline-size;
    container-name: content-body;
    display: grid;
    grid-template-columns:
      1fr minmax(min(var(--paragraph-width), 100%), 1fr)
      1fr;
    gap: var(--space-sm);
    margin: var(--space-md);

    /* 
      80ch = --paragraph-width
      needed for Chromium, as var() in @container is not supported 
    */
    @container (width <= calc(80ch * 1.75)) {
      display: flex;
      flex-direction: column-reverse;
      margin: 0;
      * {
        --header-scroll-margin: 2;
      }
    }
  }

  .content-body {
    max-width: 100%;
    grid-column: 2;
    margin-block-start: 0; /* Overriding .layout styling */
  }

  .content-layout {
    container-type: inline-size;
    container-name: content-layout;
  }

  .header-section {
    background-color: var(--bg-secondary);
    padding: var(--space-md) 0;

    .content {
      width: min(var(--paragraph-width), 100%);
    }
    .details {
      color: var(--text-secondary);
      justify-content: center;
    }
    .route {
      margin: 0 auto;
      max-width: 100%;
      color: var(--text-tertiary);
    }
  }
</style>
