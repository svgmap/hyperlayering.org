---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import UpdateCard from "@components/UpdateCard.svelte";
import { getLangFromUrl, useTranslations } from "@i18n/utils.ts";

const lang = getLangFromUrl(Astro.url);
const updates = (
	await getCollection("update", ({ id }) => {
		const [updateLang, updateId] = id.split("/");
		if (updateLang === lang) return updateId;
	})
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const t = useTranslations(lang);
---
<main>
	<article class="layout stack">
		<h1>{t("page.updates.title")}</h1>
		<section class="stack stack--md blog-post-list">
			{
				updates.map((post) => {
					const [, updateId] = post.id.split("/");
					return (
					<UpdateCard 
						title={post.data.title} 
						date={post.data.date}
						author={post.data.author}
						url={getRelativeLocaleUrl(lang, `/updates/${(updateId)}`)}
					/>
					)
				})
			}
		</section>
	</article>
</main>