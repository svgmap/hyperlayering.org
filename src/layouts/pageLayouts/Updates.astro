---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import UpdateCard from "@components/UpdateCard.svelte";
import { getLangFromUrl, useTranslations } from "@i18n/utils.ts";

const updates = await getCollection("update");
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<main>
	<article class="layout stack">
		<h1>{t("page.updates.title")}</h1>
		<section class="stack stack--md blog-post-list">
			{
				updates.map((post) => (
					<UpdateCard 
						title={post.data.title} 
						date={post.data.pubDate}
						author={post.data.author}
						url={getRelativeLocaleUrl(lang, `/updates/${post.id}`)}
							
					/>
				))
			}
		</section>
	</article>
</main>