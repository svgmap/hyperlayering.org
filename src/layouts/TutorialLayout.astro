---
import { getCollection } from "astro:content";
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from "astro:i18n";
import DocSidepanel from "@components/DocSidepanel.svelte";
import { defaultLang } from "@i18n/ui";

interface Props {
  lang: string;
}
const { lang = defaultLang } = Astro.props;
/*
const tutorials = await getCollection("tutorial", ({ id }) => {
  return id.startsWith(`${lang}/`);
});

*/
---

<div class="sidepanel-layout">
  <DocSidepanel items={tutorials} lang={lang} />
  <main class="layout flow">
    <slot class="page-content" />
  </main>
</div>

<style>
  .sidepanel-layout {
    min-height: 100%;
    width: 100vw;
    display: grid;
    grid-template-columns: 20rem minmax(0, 1fr);

    nav {
      position: sticky;
      top: var(--header-height);
      max-height: calc(100svh - var(--header-height));
      overflow-y: auto;
      list-style: none;
      padding: var(--space-sm);
      background-color: var(--bg-secondary);
    }
  }

  [id]::before {
    content: "";
    display: block;
    height: 75px;
    margin-top: -75px;
    visibility: hidden;
  }
</style>
