---
import "@styles/base.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import Footer from "@components/Footer/Footer.svelte";
import Header from "@components/Header/Header.svelte";
import { getLangFromUrl, useTranslations } from "@i18n/utils.ts";

interface Props {
	pageTitle?: string | undefined;
}
const { pageTitle = undefined } = Astro.props;
const url = Astro.url;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>
      {`${pageTitle === undefined ? "" : pageTitle + " | "}Hyper Layering`}
    </title>
  </head>
  <body>
    <Header
      client:only="svelte"
      links={[
        { href: getRelativeLocaleUrl(lang, "/"), label: t("nav.home") },
        {
          href: getRelativeLocaleUrl(lang, "/tutorials"),
          label: t("nav.tutorials"),
        },
        {
          href: getRelativeLocaleUrl(lang, "/updates"),
          label: t("nav.updates"),
        },
      ]}
      currentUrl={url}
    >
      <div class="fallback-header" slot="fallback"></div>
    </Header>
    <slot class="page-content" />
    <Footer
      linkGroups={[
        {
          groupLabel: t("nav.documentation"),
          links: [
            { label: t("nav.documentation.api"), href: "https://www.svgmap.org/wiki/index.php?title=%E8%A7%A3%E8%AA%AC%E6%9B%B8" },
            { label: t("nav.documentation.tutorials"), href: getRelativeLocaleUrl(lang, "/tutorials") },
          ],
        },
        {
          groupLabel: t("nav.resources"),
          links: [
            { label: t("nav.resources.naming-branding"), href: getRelativeLocaleUrl(lang, "/guidelines/naming-branding") },
          ],
        },
      ]}
      currentUrl={url}
    />
  </body>
</html>

<style>
  .fallback-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 1;
    height: var(--header-height);
    background: var(--bg-primary);
    border-block-end: 1px solid var(--bg-tertiary);
  }
</style>
