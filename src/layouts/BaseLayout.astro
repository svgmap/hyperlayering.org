---
import "@styles/base.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import Footer from "@components/Footer/Footer.svelte";
import Header from "@components/Header/Header.svelte";
import { getLangFromUrl, useTranslations } from "@i18n/utils.ts";

interface Props {
	pageTitle?: string | undefined;
}
const { pageTitle = undefined } = Astro.props;
const url = Astro.url;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>
      {`${pageTitle === undefined ? "" : pageTitle + " | "}Hyper Layering`}
    </title>
  </head>
  <body>
    <Header
      client:only="svelte"
      links={[
        { href: getRelativeLocaleUrl(lang, "/"), label: t("nav.home") },
        {
          href: getRelativeLocaleUrl(lang, "/tutorials"),
          label: t("nav.tutorials"),
        },
        {
          href: getRelativeLocaleUrl(lang, "/updates"),
          label: t("nav.updates"),
        },
      ]}
      currentUrl={url}
    />
    <slot class="page-content" />
    <Footer />
  </body>
</html>
