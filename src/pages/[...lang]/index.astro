---
import { getRelativeLocaleUrl } from "astro:i18n";
// import LandingWindow from "components/LandingWindow.svelte"; -- temporarily removed
import Decentralized from "@components/Illustrations/Decentralized.svelte";
import Layers from "@components/Illustrations/Layers.svelte";
import SourceCode from "@components/Illustrations/SourceCode.svelte";
import { defaultLang, languages } from "@i18n/ui";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
export async function getStaticPaths() {
	const locales = Object.keys(languages);
	return locales.map((locale) => ({
		params: { lang: locale !== defaultLang ? locale : undefined },
	}));
}
---

<BaseLayout>
  <main>
    <section class="auto-grid grid-lg landing">
      <div class="landing-intro stack">
        <h1 class="header fade-slide-in">{t("page.home.title")}</h1>
        <p class="subtitle fade-slide-in" style="--delay: 200ms;">{t("page.home.tagline")}</p>
        <div class="row fade-in" style="--delay: 600ms;">
          <a href="https://svgmap.org/demos/demo1/"
            ><button class="button accent"
              >{t("page.home.get-started-btn")}</button
            ></a
          >
          <a href="#about">
            <button class="button">{t("page.home.about-btn")}</button>
          </a>
        </div>
      </div>
    </section>
    <article class="feature-section layout--wide flow">
      <h2 class="text-center font-wide">{t("page.home.features.title")}</h2>
      <section class="auto-grid">
        <article class="card text-center" data-state="sub-grid">
          <Decentralized className="image" />
          <h3 class="title">{t("page.home.features.decentralized.title")}</h3>
          <p class="body">{t("page.home.features.decentralized.body")}</p>
        </article>
        <article class="card text-center" data-state="sub-grid">
          <Layers className="image" />
          <h3 class="title text-center">
            {t("page.home.features.layering.title")}
          </h3>
          <p class="body">{t("page.home.features.layering.body")}</p>
        </article>
        <article class="card text-center" data-state="sub-grid">
          <SourceCode className="image" />
          <h3 class="title text-center">
            {t("page.home.features.open-source.title")}
          </h3>
          <p class="body">{t("page.home.features.open-source.body")}</p>
        </article>
      </section>
    </article>
    <article id="about" class="about-section">
      <div class="layout--wide about-card">
        <section class="flow layout about-blurb">
          <h2 class="text-center font-wide">About HLA</h2>
          <hr>
          <p>Hyper-Layering Architecture (HLA) is an open architecture for combining independent content, data, and services on the Web through geographic space.</p>
          <p>Hyper-Layered Map (HLMap) is a Web map viewer based on HLA. In autumn 2026, SVGMap was renamed HLMap to reflect the broader Hyper-Layering concept.</p>
          <p>With HLA, each layer can be an independent source of content, data, or services. Instead of relying solely on information aggregated by a portal, users can freely choose and combine different sources and layers directly in their browser.</p>
          <p>HLA is not merely a concept. It is a proven foundation technology that has been used for many years to integrate more than 200 Web-based systems as map layers.</p>
        </section>
        
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .landing {
    min-height: calc(100vh - calc(var(--space-sm) * 2 + var(--header-height)));
    background-image:
      radial-gradient(
        circle at 100% 50%,
        oklch(from var(--green) l c h / 0.3) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 50% 90%,
        oklch(from var(--blue) l c h / 0.5) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 0% 100%,
        oklch(from var(--purple) l c h / 0.2) 0%,
        transparent 50%
      ),
      radial-gradient(circle at 50% 30%, var(--bg-primary) 0%, transparent 60%);
    background-blend-mode: hue;
    position: relative;

    &::after {
      container-type: size;
      display: block;
      position: absolute;
      z-index: -1;
      opacity: 0.3;
      width: 100%;
      height: 100%;
      content: "";
      background-image: url("/city_full.svg");
      background-size: 200%;
      background-repeat: no-repeat;
      background-position-x: center;
      background-position-y: bottom -70cqh;
      mix-blend-mode: luminosity;
    }

    .landing-intro {
      justify-content: center;
      align-items: center;
      min-height: 30vh;
      max-width: min(100%, var(--paragraph-width));
      margin: auto;
    }

    .header {
      font-size: var(--font-4xl);
    }

    .subtitle {
      font-size: var(--font-lg);
      margin-bottom: var(--space-sm);
    }
  }

  .feature-section {
    --min-col-size: 200px;
    container-type: inline-size;
    @container (width <= calc(var(--paragraph-width))) {
      & > * {
        --min-col-size: 100%;
      }
      
    }
  }

  .about-section {
    background: var(--bg-secondary);
    background-image:
      radial-gradient(
        circle at 100% 50%,
        oklch(from var(--green) l c h / 0.04) 0%,
        transparent 60%
      ),
      radial-gradient(
        circle at 50% 25%,
        oklch(from var(--blue) l c h / 0.04) 0%,
        transparent 60%
      ),
      radial-gradient(
        circle at 0% 100%,
        oklch(from var(--purple) l c h / 0.04) 0%,
        transparent 60%
      ),
      radial-gradient(circle at 50% 50%, var(--bg-primary) 0%, transparent 90%);
    padding-block: var(--space-sm);

    .about-card {
      padding-block: var(--space-md);
      border-radius: var(--round-sm);
      border: 1px solid var(--bg-tertiary);
      background-color: inherit;
    }

    .about-blurb {
      font-size: var(--font-base);
    }

  }
</style>
