---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
// import LandingWindow from "components/LandingWindow.svelte"; -- temporarily removed
import Decentralized from "@components/Illustrations/Decentralized.svelte";
import Layers from "@components/Illustrations/Layers.svelte";
import SourceCode from "@components/Illustrations/SourceCode.svelte";
import { defaultLang, languages } from "@i18n/ui";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
export async function getStaticPaths() {
  const locales = Object.keys(languages);
  return locales.map((locale) => ({
    params: { lang: locale !== defaultLang ? locale : undefined },
  }));
}

const homePageContent = await getCollection("home", ({ id, data }) => {
  const [homeLang] = id.split("/");
  if (homeLang === lang) return data;
}).then((data) => {
  if (data.length === 1) return data[0];
  else Astro.logger.error("Unexpected Home Page query response");
});
---

<BaseLayout>
  <main>
    <section class="auto-grid grid-lg landing">
      <div class="landing-intro stack">
        <h1 class="header fade-slide-in">{t("page.home.title")}</h1>
        <p class="subtitle fade-slide-in" style="--delay: 200ms;">
          {t("page.home.tagline")}
        </p>
        <div class="row fade-in" style="--delay: 600ms;">
          <a href="https://svgmap.org/demos/demo1/"
            ><button class="button accent"
              >{t("page.home.get-started-btn")}</button
            ></a
          >
          <a href="#about">
            <button class="button">{t("page.home.about-btn")}</button>
          </a>
        </div>
      </div>
    </section>
    <article class="feature-section layout--wide flow">
      <h2 class="text-center font-wide">{t("page.home.features.title")}</h2>
      <section class="auto-grid">
        <article class="card text-center" data-state="sub-grid">
          <Decentralized className="image" />
          <h3 class="title">{t("page.home.features.decentralized.title")}</h3>
          <p class="body">{t("page.home.features.decentralized.body")}</p>
        </article>
        <article class="card text-center" data-state="sub-grid">
          <Layers className="image" />
          <h3 class="title text-center">
            {t("page.home.features.layering.title")}
          </h3>
          <p class="body">{t("page.home.features.layering.body")}</p>
        </article>
        <article class="card text-center" data-state="sub-grid">
          <SourceCode className="image" />
          <h3 class="title text-center">
            {t("page.home.features.open-source.title")}
          </h3>
          <p class="body">{t("page.home.features.open-source.body")}</p>
        </article>
      </section>
    </article>
    <article id="about" class="about-section">
      <section class="stack layout" data-state="stack--md">
        <h2 class="text-center font-wide">About HLA</h2>
        <hr />
        {
          homePageContent?.data.aboutHyperLayering.map((section, index) => {
            return (
              <div class="flow about-group">
                <h3>{section.sectionTitle}</h3>
                <p>{section.sectionBody}</p>
              </div>
            );
          })
        }
        <div class="flow text-lg font-wide font-bold text-center">
          {homePageContent?.data.aboutCloser.split("\n").filter((s) => s.length > 0).map((line) => 
          (<p class="text-wrap-balance">{line}</p>)
        )}
        </div>
      </section>
    </article>
  </main>
</BaseLayout>

<style>
  .landing {
    min-height: calc(100vh - calc(var(--space-sm) * 2 + var(--header-height)));
    background-image:
      radial-gradient(
        circle at 100% 50%,
        oklch(from var(--green) l c h / 0.3) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 50% 90%,
        oklch(from var(--blue) l c h / 0.5) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 0% 100%,
        oklch(from var(--purple) l c h / 0.2) 0%,
        transparent 50%
      ),
      radial-gradient(circle at 50% 30%, var(--bg-primary) 0%, transparent 60%);
    background-blend-mode: hue;
    position: relative;

    &::after {
      container-type: size;
      display: block;
      position: absolute;
      z-index: -1;
      opacity: 0.3;
      width: 100%;
      height: 100%;
      content: "";
      background-image: url("/city_full.svg");
      background-size: 200%;
      background-repeat: no-repeat;
      background-position-x: center;
      background-position-y: bottom -70cqh;
      mix-blend-mode: luminosity;
    }

    .landing-intro {
      justify-content: center;
      align-items: center;
      min-height: 30vh;
      max-width: min(100%, var(--paragraph-width));
      margin: auto;
    }

    .header {
      font-size: var(--font-4xl);
    }

    .subtitle {
      font-size: var(--font-lg);
      margin-bottom: var(--space-sm);
    }
  }

  .feature-section {
    --min-col-size: 200px;
    container-type: inline-size;
    @container (width <= calc(var(--paragraph-width))) {
      & > * {
        --min-col-size: 100%;
      }
    }
  }

  .about-section {
    position: relative;
    z-index: 1;
    padding-block: var(--space-sm);
    overflow: hidden;
    &::before {
      container-type: size;
      top: 0;
      display: block;
      position: absolute;
      z-index: -1;
      width: 100%;
      height: 100%;
      content: "";
      background-image:
        linear-gradient(
          to bottom,
          var(--bg-secondary) 0%,
          rgba(0, 0, 0, 0) 50%,
          var(--bg-secondary) 100%
        ),
        radial-gradient(
          circle at 100% 50%,
          oklch(from var(--green) l c h / 0.05) 0%,
          transparent 60%
        ),
        radial-gradient(
          circle at 50% 25%,
          oklch(from var(--blue) l c h / 0.05) 0%,
          transparent 60%
        ),
        radial-gradient(
          circle at 0% 100%,
          oklch(from var(--purple) l c h / 0.05) 0%,
          transparent 60%
        ),
        radial-gradient(
          circle at 50% 50%,
          var(--bg-primary) 0%,
          transparent 90%
        );
    }
    &::after {
      container-type: size;
      top: 0;
      display: block;
      position: absolute;
      z-index: -2;
      opacity: 0.3;
      width: 100%;
      height: 100%;
      content: "";
      background-size: 1em 1em;
      background-image:
        linear-gradient(to right, grey 1px, transparent 1px),
        linear-gradient(to bottom, grey 1px, transparent 1px);
      transform: perspective(3000px) rotateX(45deg);
    }

    .about-group::after {
      content: "";
      container-type: size;
      display: flex;
      width: 2px;
      height: 4em;
      border-inline-end: 2px dotted var(--text-tertiary);
      margin-block: var(--space-xs);
      margin-inline: auto;
    }
  }

  .dot-line {
    
  }
</style>
