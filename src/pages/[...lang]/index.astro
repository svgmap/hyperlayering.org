---
import { getRelativeLocaleUrl } from "astro:i18n";
// import LandingWindow from "components/LandingWindow.svelte"; -- temporarily removed
import Decentralized from "@components/Illustrations/Decentralized.svelte";
import Layers from "@components/Illustrations/Layers.svelte";
import SourceCode from "@components/Illustrations/SourceCode.svelte";
import { defaultLang, languages } from "@i18n/ui";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
export async function getStaticPaths() {
	const locales = Object.keys(languages);
	return locales.map((locale) => ({
		params: { lang: locale !== defaultLang ? locale : undefined },
	}));
}
---

<BaseLayout>
  <main>
    <section class="auto-grid grid-lg landing">
      <div class="landing-intro stack">
        <h1 class="header fade-slide-in">{t("page.home.title")}</h1>
        <p class="subtitle fade-slide-in" style="--delay: 200ms;">{t("page.home.tagline")}</p>
        <div class="row fade-in" style="--delay: 600ms;">
          <a href={getRelativeLocaleUrl(lang, "tutorials")}
            ><button class="button accent"
              >{t("page.home.get-started-btn")}</button
            ></a
          >
          <button class="button">{t("page.home.about-btn")}</button>
        </div>
      </div>
    </section>
    <article class="feature-section layout--wide flow">
      <h2 class="text-center font-wide">{t("page.home.features.title")}</h2>
      <section class="auto-grid">
        <article class="card text-center" data-state="sub-grid">
          <Decentralized className="image" />
          <h3 class="title">{t("page.home.features.decentralized.title")}</h3>
          <p class="body">{t("page.home.features.decentralized.body")}</p>
        </article>
        <article class="card text-center" data-state="sub-grid">
          <Layers className="image" />
          <h3 class="title text-center">
            {t("page.home.features.tiling.title")}
          </h3>
          <p class="body">{t("page.home.features.tiling.body")}</p>
        </article>
        <article class="card text-center" data-state="sub-grid">
          <SourceCode className="image" />
          <h3 class="title text-center">
            {t("page.home.features.open-source.title")}
          </h3>
          <p class="body">{t("page.home.features.open-source.body")}</p>
        </article>
      </section>
    </article>
    <article class="about-section">
      <div class="layout--wide about-card">
        <section class="flow layout about-blurb">
          <h2 class="text-center font-wide">About HLA</h2>
          <hr>
          <p>Pellentesque habitant morbi tristique senectus et netus et malesuada fames ac turpis egestas. Vestibulum tortor quam, feugiat vitae, ultricies eget, tempor sit amet, ante. Donec eu libero sit amet quam egestas semper. Aenean ultricies mi vitae est. Mauris placerat eleifend leo. Quisque sit amet est et sapien ullamcorper pharetra. Vestibulum erat wisi, condimentum sed, commodo vitae, ornare sit amet, wisi. Aenean fermentum, elit eget tincidunt condimentum, eros ipsum rutrum orci, sagittis tempus lacus enim ac dui. Donec non enim in turpis pulvinar facilisis. Ut felis. Praesent dapibus, neque id cursus faucibus, tortor neque egestas augue, eu vulputate magna eros eu erat. Aliquam erat volutpat. Nam dui mi, tincidunt quis, accumsan porttitor, facilisis luctus, metus</p>
        </section>
        
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .landing {
    min-height: calc(100vh - calc(var(--space-sm) * 2 + var(--header-height)));
    background-image:
      radial-gradient(
        circle at 100% 50%,
        oklch(from var(--green) l c h / 0.3) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 50% 90%,
        oklch(from var(--blue) l c h / 0.5) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 0% 100%,
        oklch(from var(--purple) l c h / 0.2) 0%,
        transparent 50%
      ),
      radial-gradient(circle at 50% 30%, var(--bg-primary) 0%, transparent 60%);
    background-blend-mode: hue;
    position: relative;

    &::after {
      container-type: size;
      display: block;
      position: absolute;
      z-index: -1;
      opacity: 0.3;
      width: 100%;
      height: 100%;
      content: "";
      background-image: url("/city_full.svg");
      background-size: 200%;
      background-repeat: no-repeat;
      background-position-x: center;
      background-position-y: bottom -70cqh;
      mix-blend-mode: luminosity;
    }

    .landing-intro {
      justify-content: center;
      align-items: center;
      min-height: 30vh;
      max-width: min(100%, var(--paragraph-width));
      margin: auto;
    }

    .header {
      font-size: var(--font-4xl);
    }

    .subtitle {
      font-size: var(--font-lg);
      margin-bottom: var(--space-sm);
    }
  }

  .feature-section {
    --min-col-size: 200px;
    container-type: inline-size;
    @container (width <= calc(var(--paragraph-width))) {
      & > * {
        --min-col-size: 100%;
      }
      
    }
  }

  .about-section {
    background: var(--bg-secondary);
    background-image:
      radial-gradient(
        circle at 100% 50%,
        oklch(from var(--green) l c h / 0.04) 0%,
        transparent 60%
      ),
      radial-gradient(
        circle at 50% 25%,
        oklch(from var(--blue) l c h / 0.04) 0%,
        transparent 60%
      ),
      radial-gradient(
        circle at 0% 100%,
        oklch(from var(--purple) l c h / 0.04) 0%,
        transparent 60%
      ),
      radial-gradient(circle at 50% 50%, var(--bg-primary) 0%, transparent 90%);
    padding-block: var(--space-sm);

    .about-card {
      padding-block: var(--space-md);
      border-radius: var(--round-sm);
      border: 1px solid var(--bg-tertiary);
      background-color: inherit;
    }

    .about-blurb {
      font-size: var(--font-base);
    }

  }
</style>
