---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import UpdateCard from "@components/UpdateCard.svelte";
import { defaultLang, languages } from "@i18n/ui";
import { getLangFromUrl, useTranslations } from "@i18n/utils.ts";
import BaseLayout from "@layouts/BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const updates = (
	await getCollection("update", ({ id }) => {
		const [updateLang, updateId] = id.split("/");
		if (updateLang === lang) return updateId;
	})
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

export async function getStaticPaths() {
	const locales = Object.keys(languages);
	return locales.map((locale) => ({
		params: { lang: locale !== defaultLang ? locale : undefined },
	}));
}
---

<BaseLayout pageTitle="Updates">
  <main>
    <article class="stack">
      <div class="update-header-section">
        <h1>{t("page.updates.title")}</h1>
      </div>
      <section class="layout stack stack--sm updates-wrapper">
        {
          updates.map((post) => {
            const [, updateId] = post.id.split("/");
            return (
              <UpdateCard
                client:only="svelte"
                title={post.data.title}
                description={post.data.description}
                author={post.data.author}
                date={post.data.date}
                url={getRelativeLocaleUrl(lang, `/updates/${updateId}`)}
                lang={lang}
              />
            );
          })
        }
      </section>
    </article>
  </main>
</BaseLayout>

<style>
  .update-header-section {
    align-content: center;
    text-align: center;
    padding: var(--space-md);

  }

  .updates-wrapper {
    margin-block-start: 0;
  }
</style>
