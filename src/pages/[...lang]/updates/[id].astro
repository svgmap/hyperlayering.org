---
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { defaultLang, languages } from "@i18n/ui";
import { getLangFromUrl } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import ContentLayout from "@layouts/ContentLayout.astro";
export async function getStaticPaths() {
  const updates = await getCollection("update");
  const parsedUpdates = updates.map((post) => {
    const [updateLang, updateId] = post.id.split("/");
    return {
      params: {
        lang: updateLang !== defaultLang ? updateLang : undefined,
        id: updateId,
      },
      props: { post, updateId },
    };
  });
  return parsedUpdates;
}

const lang = getLangFromUrl(Astro.url);
const { post, updateId } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout pageTitle={`Updates - ${post.data.title}`}>
  <ContentLayout title={post.data.title}>
    <Fragment slot="route">
      <small class="route row"
        ><a href={getRelativeLocaleUrl(lang, "/updates")}>updates</a><span
          >/</span
        >{updateId}</small
      >
    </Fragment>
    <Fragment slot="details">
      <span>{post.data.author}</span>
      <span>&#x2022;</span>
      <span>{post.data.date.toLocaleString(lang, { dateStyle: "long" })}</span>
    </Fragment>
    <Content slot="content" />
  </ContentLayout>
</BaseLayout>
