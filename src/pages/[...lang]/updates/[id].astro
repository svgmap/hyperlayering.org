---
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { defaultLang, languages } from "@i18n/ui";
import { getLangFromUrl } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
export async function getStaticPaths() {
  const updates = await getCollection("update");
  const parsedUpdates = updates.map((post) => {
    const [updateLang, updateId] = post.id.split("/");
    return {
      params: {
        lang: updateLang !== defaultLang ? updateLang : undefined,
        id: updateId,
      },
      props: { post },
    };
  });
  return parsedUpdates
}

const lang = getLangFromUrl(Astro.url);
const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout pageTitle={`Updates - ${post.data.title}`}>
  <main>
    <article class="layout stack">
      <section class="stack header-section">
        <small
          ><a href={getRelativeLocaleUrl(lang, "/updates")}>updates</a
          >/{post.id}</small
        >
        <h1 class="title">{post.data.title}</h1>
        <div>
          <span>{post.data.author}</span>
          &nbsp;&mdash;&nbsp;
          <span
            >{
              post.data.date.toLocaleString("en-GB", { dateStyle: "short" })
            }</span
          >
        </div>
        <hr />
      </section>
      <section class="content flow">
        <Content />
      </section>
    </article>
  </main>
</BaseLayout>

<style scoped>
  .header-section {
    text-align: center;
    margin-bottom: var(--space-md);
  }
</style>
